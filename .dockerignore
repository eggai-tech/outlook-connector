.git
.github
.venv
__pycache__/
*.py[oc]
.pytest_cache
build/
dist/
wheels/
*.egg-info

# Secrets / local config — never bake into the image
.env*
config*.yaml
!config.yaml.example
# HLB deployment bakes a non-secret structural config.yaml into the image (ACA
# can't bind-mount). Secrets still come from env/Key Vault, never this file.
!config.yaml

.DS_Store
docs
tests
development

# Vendored library dev material — the wheel only needs libs/*/outlook_helper,
# its pyproject and its README.
libs/*/tests
libs/*/docs
libs/*/specs
libs/*/implementation
libs/*/AGENTS.md
libs/*/.python-version
