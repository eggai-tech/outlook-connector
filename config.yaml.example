# Outlook connector — structural configuration.
#
# Copy to config.yaml (or point CONFIG_FILE at it) and edit. Azure credentials
# are NOT set here — AZURE_TENANT_ID, AZURE_CLIENT_ID and AZURE_CLIENT_SECRET
# come from the environment, and the connector refuses to start if this file
# carries any of them.

# The mailbox to poll.
mailbox: inbox@example.com

# Fixed-delay between poll cycles, in seconds.
poll_interval_seconds: 60

# Optional: seed the mailbox cursor from this instant (ISO 8601) instead of
# process-start "now". Only mail received strictly after this point is bridged.
# Leave commented to start from "now".
# initial_cursor: 2026-06-26T08:00:00Z

# Log level (stdlib logging name): DEBUG | INFO | WARNING | ERROR.
log_level: INFO

# EggAI bus connection. The channel name is prefixed by the eggai SDK with the
# EGGAI_NAMESPACE environment variable (default "eggai"), so events land on
# "<namespace>.<channel>" — set EGGAI_NAMESPACE to match your consumers.
bus:
  transport: kafka          # kafka | redis | inmemory
  broker_url: localhost:19092  # bootstrap servers (kafka) / URL (redis); omit for transport default
  channel: emails

# Redis variant:
# bus:
#   transport: redis
#   broker_url: redis://localhost:6379/0
#   channel: emails

