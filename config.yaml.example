# Outlook connector — structural configuration.
#
# Copy to config.yaml (or point CONFIG_FILE at it) and edit. Azure credentials
# are NOT set here — AZURE_TENANT_ID, AZURE_CLIENT_ID and AZURE_CLIENT_SECRET
# come from the environment, and the connector refuses to start if this file
# carries any of them.

# The mailbox to poll.
mailbox: inbox@example.com

# Folder to poll: a well-known Graph name ("inbox") or a display name.
# source_folder: inbox

# Fixed-delay between poll cycles, in seconds.
poll_interval_seconds: 60

# At most this many messages fetched + published per cycle, oldest first —
# a backlog (or a restart's re-emit) drains predictably across cycles.
# Default 100; null removes the bound (only sensible for small folders).
# batch_max_messages: 100

# Attachments larger than this are published as metadata only (body: null).
# Default 8388608 (8 MiB). Mind your broker's message-size limit — kafka
# defaults to ~1MB per message.
# max_attachment_bytes: 8388608

# Also publish the full RFC 822 message (headers, bodies, every attachment
# base64-encoded again) as email.mime_content, at the cost of one extra Graph
# call per message. Attachments stay on the wire too, so the event roughly
# doubles in size, and the MIME is NOT bounded by max_attachment_bytes — mind
# the broker's message-size limit. Default false (mime_content is null).
# include_mime_content: false

# Optional lower bound (ISO 8601): mail received before this instant is never
# listed or published. Leave commented to bridge the whole source folder —
# every rescan re-emits anything still present; consumers dedupe on
# internet_message_id. Set this to keep an old, full folder from backfilling.
# ignore_received_before: 2026-06-26T08:00:00Z

# HTTP health/status endpoint: GET /health reports uptime, Graph/bus status
# and the last poll cycle. 200 while the poll loop ticks, 503 once it is
# wedged. Default 8000; set to null to disable.
# health_port: 8000

# Log level (stdlib logging name): DEBUG | INFO | WARNING | ERROR.
log_level: INFO

# EggAI bus connection. The channel name is prefixed by the eggai SDK with the
# EGGAI_NAMESPACE environment variable (default "eggai"), so events land on
# "<namespace>.<channel>" — set EGGAI_NAMESPACE to match your consumers.
bus:
  transport: kafka          # kafka | redis | inmemory
  broker_url: localhost:19092  # bootstrap servers (kafka) / URL (redis); omit for transport default
  channel: emails

# Redis variant. Redis streams keep every entry in memory, acked or not, so
# cap the stream with max_len (XADD MAXLEN ~): the oldest entries are trimmed
# by count once the stream exceeds it, whether or not consumers have read
# them. Size it to your memory budget and expected consumer lag; unset means
# unbounded. Ignored by other transports.
# bus:
#   transport: redis
#   broker_url: redis://localhost:6379/0
#   channel: emails
#   max_len: 1000

