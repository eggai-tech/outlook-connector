# Copy to .env (git-ignored) and fill in. `just init` does the copy for you.
#
# docker-compose reads this file twice: once to interpolate ${...} in the
# compose file itself, and once as the connector container's env_file.
# Structural configuration lives in config.yaml — only credentials and
# environment-specific overrides belong here.

# --- required ---------------------------------------------------------------
# Azure app-registration. All three come from the environment together and are
# rejected outright if found in config.yaml — the connector refuses to start.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- EggAI bus (overrides config.yaml; `__` is the nesting delimiter) --------
# The compose stack defaults these to its own redis. Uncomment to point the
# connector somewhere else, e.g. an existing kafka broker.
# BUS__TRANSPORT=kafka
# BUS__BROKER_URL=localhost:19092

# LOG_LEVEL=INFO
# EGGAI_NAMESPACE=eggai

# --- supporting services ----------------------------------------------------
# POSTGRES_USER=eggai
# POSTGRES_PASSWORD=eggai
# POSTGRES_DB=outlook-connector

# Host port mapping — change when the defaults collide with something already
# running on your machine. These affect the host side only; inside the compose
# network the services are always redis:6379 and postgres:5432.
# POSTGRES_HOST_PORT=15432
# REDIS_HOST_PORT=16379
